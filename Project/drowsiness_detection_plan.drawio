<mxfile host="app.diagrams.net"><diagram id="plan" name="Project Plan"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1500" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;&lt;font style=&quot;font-size:22px&quot;&gt;Awaken! – Real-Time Driver Drowsiness Detection – Project Plan&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Webcam → grayscale → YOLO11s (7 classes) + MediaPipe EAR / MAR / head pose → threshold rules → 2-level beep alarm&lt;br&gt;8 weeks: 9 Nov 2026 – 3 Jan 2027 · Team P &amp; J · Colab training · laptop webcam demo (offline)" style="text;html=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1460" height="80" as="geometry"/></mxCell><mxCell id="h1" value="&lt;b&gt;Phase 1: Scoping, Setup &amp; Decisions&lt;/b&gt;&lt;br&gt;Week 1 · Owner P" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="320" height="50" as="geometry"/></mxCell><mxCell id="b1" value="• Freeze decisions: YOLO11s, Option C hybrid, 7 classes, threshold rules&lt;br&gt;• GitHub repo, AGPL-3.0 licence, requirements pinned&lt;br&gt;• Check Python 3.14.7 vs PyTorch / Ultralytics / MediaPipe (fallback 3.11/3.12)&lt;br&gt;• Short literature note: PERCLOS, EAR, MAR, YOLO drowsiness&lt;br&gt;• Agree function contracts: detector, features, rule engine&lt;br&gt;&lt;b&gt;Deliverable:&lt;/b&gt; repo, env on both machines, decisions doc" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#f5f9ff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="320" height="270" as="geometry"/></mxCell><mxCell id="h2" value="&lt;b&gt;Phase 2: Dataset Audit &amp; Labelling&lt;/b&gt;&lt;br&gt;Week 1–2 · Owner J" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="420" y="110" width="320" height="50" as="geometry"/></mxCell><mxCell id="b2" value="• Audit HF dataset (3.1 GB, grayscale): labels? boxes? subject IDs? shoulders visible?&lt;br&gt;• Gate (end wk 1): boxes exist → convert; image labels only → auto-label&lt;br&gt;• Auto-label boxes + states with MediaPipe, review 300–500 images in Label Studio&lt;br&gt;• Classes: face, eye_open, eye_closed, yawn, mouth_closed, head_down, posture_alert&lt;br&gt;• Split 70/15/15 (by subject if possible); data zip on Drive&lt;br&gt;&lt;b&gt;Deliverable:&lt;/b&gt; dataset.yaml, labelled split data, annotation guide" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#f4fbf3;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="420" y="160" width="320" height="270" as="geometry"/></mxCell><mxCell id="h3" value="&lt;b&gt;Phase 3: MediaPipe Feature Module&lt;/b&gt;&lt;br&gt;Week 2–3 · Owner P" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="800" y="110" width="320" height="50" as="geometry"/></mxCell><mxCell id="b3" value="• MediaPipe FaceLandmarker on YOLO face crop (dlib dropped)&lt;br&gt;• &lt;b&gt;EAR&lt;/b&gt; per eye, &lt;b&gt;MAR&lt;/b&gt; mouth, &lt;b&gt;head pitch&lt;/b&gt; via solvePnP&lt;br&gt;• Smoothing, missing-face handling&lt;br&gt;• Per-driver calibration (first 20–30 s)&lt;br&gt;• Also generates auto-labels for Phase 2&lt;br&gt;&lt;b&gt;Deliverable:&lt;/b&gt; src/features + unit tests" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#fffbed;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="800" y="160" width="320" height="270" as="geometry"/></mxCell><mxCell id="h4" value="&lt;b&gt;Phase 4: YOLO11s Training&lt;/b&gt;&lt;br&gt;Week 3–5 · Owner J" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1180" y="110" width="320" height="50" as="geometry"/></mxCell><mxCell id="b4" value="• Baseline: yolo11s.pt, imgsz 640, 100 epochs on Colab&lt;br&gt;• Experiments: imgsz, augmentation, freeze layers, imbalance&lt;br&gt;• Pick checkpoint by recall on eye_closed / yawn + mAP@0.5&lt;br&gt;• Checkpoints to Drive each epoch, resume after disconnects&lt;br&gt;• Export ONNX, measure ms/frame on the demo laptop&lt;br&gt;&lt;b&gt;M1 (6 Dec):&lt;/b&gt; first model running in the live loop" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#fff8ef;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1180" y="160" width="320" height="270" as="geometry"/></mxCell><mxCell id="h5" value="&lt;b&gt;Phase 5: Fusion &amp; Temporal Rules&lt;/b&gt;&lt;br&gt;Week 4–6 · Owner J" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="320" height="50" as="geometry"/></mxCell><mxCell id="b5" value="• Eye closed = YOLO eye_closed OR EAR &amp;lt; 0.75×baseline&lt;br&gt;• &lt;b&gt;Level 1 Drowsy:&lt;/b&gt; closure ≥ 1 s, PERCLOS ≥ 0.20, 3 yawns/5 min, nods&lt;br&gt;• &lt;b&gt;Level 2 Asleep:&lt;/b&gt; closure ≥ 2 s, PERCLOS ≥ 0.40, head down + eyes closed&lt;br&gt;• Hysteresis, beep cooldown, &#x27;face not found&#x27; after 5 s&lt;br&gt;• Thresholds in thresholds.yaml; event CSV log (no video)&lt;br&gt;&lt;b&gt;Deliverable:&lt;/b&gt; src/rules + tests" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#f8f3fa;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="570" width="320" height="270" as="geometry"/></mxCell><mxCell id="h6" value="&lt;b&gt;Phase 6: Evaluation&lt;/b&gt;&lt;br&gt;Week 6–7 · Owner P" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="420" y="520" width="320" height="50" as="geometry"/></mxCell><mxCell id="b6" value="• mAP@0.5 ≥ 0.80, recall eye_closed/yawn ≥ 0.90 (proposed)&lt;br&gt;• Confusion matrix, PR curves, per-class results&lt;br&gt;• Ablation: YOLO only vs YOLO + MediaPipe fusion&lt;br&gt;• Threshold sweep: favour recall, limit false alarms/hour&lt;br&gt;• Per-stage timing, FPS, fairness check on varied people&lt;br&gt;&lt;b&gt;Deliverable:&lt;/b&gt; results tables, final model + thresholds" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#fdf1f0;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="420" y="570" width="320" height="270" as="geometry"/></mxCell><mxCell id="h7" value="&lt;b&gt;Phase 7: Real-Time App&lt;/b&gt;&lt;br&gt;Skeleton W3–4 · Full W6–7 · Owner P" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;" vertex="1" parent="1"><mxGeometry x="800" y="520" width="320" height="50" as="geometry"/></mxCell><mxCell id="b7" value="• Skeleton early: capture + inference threads, overlay, 2 beeps&lt;br&gt;• Overlay: boxes, state, PERCLOS bar, FPS, level banner&lt;br&gt;• Plug in best model, MediaPipe, rules, calibration screen&lt;br&gt;• Target ≥ 30 FPS: ONNX, smaller imgsz, MediaPipe on crop&lt;br&gt;• Offline test (Wi-Fi off), CSV event log&lt;br&gt;&lt;b&gt;Deliverable:&lt;/b&gt; working real-time demo" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#eef8fc;strokeColor=#10739e;" vertex="1" parent="1"><mxGeometry x="800" y="570" width="320" height="270" as="geometry"/></mxCell><mxCell id="h8" value="&lt;b&gt;Phase 8: Testing &amp; Delivery&lt;/b&gt;&lt;br&gt;Week 7–8 · Owners P + J" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0cee2;strokeColor=#56517e;" vertex="1" parent="1"><mxGeometry x="1180" y="520" width="320" height="50" as="geometry"/></mxCell><mxCell id="b8" value="• Safe seated tests: eye closure, yawns, nods, slumping; several people&lt;br&gt;• 30 min normal use → false alarms/hour&lt;br&gt;• Freeze features at M3 (27 Dec), final threshold tuning&lt;br&gt;• Report, slides, demo video (plus backup recording)&lt;br&gt;• README, model card, v1.0 release (AGPL-3.0)&lt;br&gt;&lt;b&gt;Deliverable:&lt;/b&gt; report, code, slides, demo video" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#f4f3f9;strokeColor=#56517e;" vertex="1" parent="1"><mxGeometry x="1180" y="570" width="320" height="270" as="geometry"/></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="h1" target="h2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="h2" target="h3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="h3" target="h4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="b4" target="h5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1340" y="470"/><mxPoint x="200" y="470"/></Array></mxGeometry></mxCell><mxCell id="e56" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="h5" target="h6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e67" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="h6" target="h7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e78" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="h7" target="h8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e65" value="iterate: retune thresholds / retrain once" style="edgeStyle=orthogonalEdgeStyle;rounded=1;dashed=1;endArrow=block;strokeColor=#b85450;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="b6" target="b5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="580" y="870"/><mxPoint x="200" y="870"/></Array></mxGeometry></mxCell><mxCell id="tl_t" value="&lt;b&gt;Timeline (8 weeks, dates = week start)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="890" width="400" height="30" as="geometry"/></mxCell><mxCell id="exam" value="Exams (assumed wk 5–6): reduced capacity" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;opacity=40;dashed=1;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="925" width="280" height="365" as="geometry"/></mxCell><mxCell id="wk1" value="&lt;b&gt;W1&lt;/b&gt;&lt;br&gt;9 Nov" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="200" y="930" width="140" height="36" as="geometry"/></mxCell><mxCell id="wk2" value="&lt;b&gt;W2&lt;/b&gt;&lt;br&gt;16 Nov" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="340" y="930" width="140" height="36" as="geometry"/></mxCell><mxCell id="wk3" value="&lt;b&gt;W3&lt;/b&gt;&lt;br&gt;23 Nov" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="480" y="930" width="140" height="36" as="geometry"/></mxCell><mxCell id="wk4" value="&lt;b&gt;W4&lt;/b&gt;&lt;br&gt;30 Nov" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="620" y="930" width="140" height="36" as="geometry"/></mxCell><mxCell id="wk5" value="&lt;b&gt;W5&lt;/b&gt;&lt;br&gt;7 Dec" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="930" width="140" height="36" as="geometry"/></mxCell><mxCell id="wk6" value="&lt;b&gt;W6&lt;/b&gt;&lt;br&gt;14 Dec" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="900" y="930" width="140" height="36" as="geometry"/></mxCell><mxCell id="wk7" value="&lt;b&gt;W7&lt;/b&gt;&lt;br&gt;21 Dec" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1040" y="930" width="140" height="36" as="geometry"/></mxCell><mxCell id="wk8" value="&lt;b&gt;W8&lt;/b&gt;&lt;br&gt;28 Dec" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1180" y="930" width="140" height="36" as="geometry"/></mxCell><mxCell id="t1" value="P1 Scoping &amp; setup" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="200" y="975" width="140" height="32" as="geometry"/></mxCell><mxCell id="t2" value="P2 Dataset audit &amp; labelling" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="200" y="1013" width="280" height="32" as="geometry"/></mxCell><mxCell id="t3" value="P3 MediaPipe features" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="340" y="1051" width="280" height="32" as="geometry"/></mxCell><mxCell id="t4" value="P4 YOLO11s training  (M1: 6 Dec)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="480" y="1089" width="420" height="32" as="geometry"/></mxCell><mxCell id="t5" value="P5 Fusion &amp; rules" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="620" y="1127" width="420" height="32" as="geometry"/></mxCell><mxCell id="t6" value="P6 Evaluation" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="900" y="1165" width="280" height="32" as="geometry"/></mxCell><mxCell id="t7" value="P7 Real-time app (skeleton W3–4, full W6–7)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#b1ddf0;strokeColor=#10739e;fontSize=11;" vertex="1" parent="1"><mxGeometry x="480" y="1203" width="700" height="32" as="geometry"/></mxCell><mxCell id="t8" value="P8 Testing &amp; delivery" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#d0cee2;strokeColor=#56517e;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1040" y="1241" width="280" height="32" as="geometry"/></mxCell><mxCell id="ms" value="&lt;b&gt;Milestones&lt;/b&gt;&lt;br&gt;M1 6 Dec: first model + live skeleton · M2 20 Dec: rules calibrated · M3 27 Dec: feature freeze · M4 3 Jan: report, slides, video, release · 4–7 Jan: buffer (deadline ≈ 7 Jan)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#e6e6e6;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="975" width="150" height="305" as="geometry"/></mxCell><mxCell id="risk" value="&lt;b&gt;Key risks &amp; mitigations&lt;/b&gt;&lt;br&gt;• Dataset has no boxes → MediaPipe auto-labelling + small manual review; decide at week-1 gate&lt;br&gt;• Exams wk 5–6 → front-load to M1, unattended Colab runs, reduced scope&lt;br&gt;• False alarms → duration rules, hysteresis, calibration, threshold sweep&lt;br&gt;• 30 FPS on laptop → early skeleton, ONNX, smaller imgsz, MediaPipe on face crop&lt;br&gt;• Grayscale data vs colour webcam → convert frames to grayscale, test at M1&lt;br&gt;• Colab disconnects → per-epoch checkpoints on Drive, resume=True&lt;br&gt;• Privacy → on-device, no video stored, log only triggered values" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="1310" width="1460" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>